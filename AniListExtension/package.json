{
  "name": "anilist-crunchyroll-companion",
  "description": "An companion extension for AniList that adds some QoL features on Crunchyroll to interact with AniList.",
  "private": true,
  "version": "1.1.1",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:chrome": "wxt -b chrome",
    "build": "pnpm run generate && wxt build",
    "build:chrome": "pnpm run generate && wxt build -b chrome",
    "zip": "wxt zip",
    "zip:chrome": "wxt zip -b chrome",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "postinstall": "wxt prepare",
    "generate": "graphql-codegen"
  },
  "devDependencies": {
    "@tsconfig/svelte": "^5.0.8",
    "@wxt-dev/module-svelte": "^2.0.4",
    "svelte": "^5.53.11",
    "svelte-check": "^4.4.5",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "wxt": "^0.20.18"
  },
  "dependencies": {
    "@graphql-codegen/cli": "^5.0.7",
    "@wxt-dev/auto-icons": "^1.1.1",
    "bootstrap": "^5.3.8"
  }
}
